SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development
MAX_UPLOAD_SIZE_MB=50
FILE_RETENTION_HOURS=1

# ── Render (production) — set these as environment variables on Render ──
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECRET_KEY=<long-random-secret>
# DATABASE_URL=postgresql://user:pass@host:5432/db
# ALLOWED_HOSTS=.onrender.com
# CSRF_TRUSTED_ORIGINS=https://<frontend>.netlify.app,https://<backend>.onrender.com
# CORS_ALLOWED_ORIGINS=https://<frontend>.netlify.app
# SITE_URL=https://<backend>.onrender.com
# SESSION_COOKIE_SAMESITE=None
# CSRF_COOKIE_SAMESITE=None
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=