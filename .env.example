SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development
MAX_UPLOAD_SIZE_MB=50
FILE_RETENTION_HOURS=1

# ── Render (production) — set these as environment variables on Render ──
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECRET_KEY=<long-random-secret>
# DATABASE_URL=postgresql://user:pass@host:5432/db
# ALLOWED_HOSTS=.onrender.com
# CSRF_TRUSTED_ORIGINS=https://<frontend>.netlify.app,https://<backend>.onrender.com
# CORS_ALLOWED_ORIGINS=https://<frontend>.netlify.app
# SITE_URL=https://<backend>.onrender.com
# SESSION_COOKIE_SAMESITE=None
# CSRF_COOKIE_SAMESITE=None
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
# JIRA_BASE_URL=https://votre-instance.atlassian.net   # liens hypertexte tickets Jira (Excel + Kanban)
# FRONTEND_URL=https://<frontend>.netlify.app            # liens des e-mails vers l'interface React
#
# ── Synchronisation Jira Cloud (anomalies) ──
# JIRA_EMAIL=compte-technique@global-itec.com
# JIRA_API_TOKEN=<jeton API Atlassian>
# JIRA_WEBHOOK_SECRET=<secret du webhook, URL : https://<backend>/api/integrations/jira/webhook/>
#
# ── Stockage S3 (captures, pièces jointes, recettes) ──
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=eu-west-3
# S3_ENDPOINT_URL=            # R2, Scaleway, MinIO… (vide pour AWS)
# S3_ADDRESSING_STYLE=        # "path" pour MinIO
# S3_PREFIX=media
